---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CopyBlock from "../components/CopyBlock.astro";
import BrandImage from "../components/BrandImage.astro";
import CTAButton from "../components/CTAButton.astro";
import PressQuote from "../components/PressQuote.astro";
import Icon from "../components/Icon.astro";
import Sigil from "../components/Sigil.astro";

import { bio } from "../data/bio";
import { contacts, mailto } from "../data/contacts";
import { socials, links } from "../data/socials";
import { pressAssets, pressPhotos } from "../data/assets";
import { upcomingShows } from "../data/shows";
import { releases } from "../data/releases";

const downloads = [
  { label: "Press photos", note: "High-resolution, print ready", file: pressAssets.photoPack },
  { label: "Logo pack", note: "SVG, PNG, light and dark", file: pressAssets.logoPack },
  { label: "Technical rider", note: "PDF", file: pressAssets.techRider },
  { label: "Stage plot", note: "PDF", file: pressAssets.stagePlot },
];

const stats = [
  { value: "~30K", label: "Monthly Spotify listeners" },
  { value: `${releases.length}+`, label: "Releases" },
  { value: `${upcomingShows().length}`, label: "Upcoming dates" },
  { value: "Philadelphia", label: "Home base" },
];
---

<Layout
  title="Press & EPK"
  description="HEXXA electronic press kit — bios, press photos, logos, technical rider, stats and booking contacts."
>
  <PageHeader
    eyebrow="Electronic press kit"
    title="Press Kit"
    lede="Everything needed to announce, book or write about HEXXA. Bios are copy-ready and assets are print-resolution."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      {
        contacts.map((contact, index) => (
          <CTAButton
            href={mailto(contact, `${contact.role} enquiry — HEXXA`)}
            variant={index === 0 ? "primary" : "outline"}
            icon="mail"
          >
            {contact.role}
          </CTAButton>
        ))
      }
    </div>
  </PageHeader>

  <!-- ===================== STATS ===================== -->
  <section class="border-b border-bone/10 bg-ink">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <dl class="grid grid-cols-2 divide-bone/10 lg:grid-cols-4 lg:divide-x">
        {
          stats.map((stat) => (
            <div class="border-b border-bone/10 px-1 py-8 lg:border-b-0 lg:px-6 lg:first:pl-0">
              <dt class="font-sans text-[0.62rem] font-bold uppercase tracking-[0.2em] text-ash">
                {stat.label}
              </dt>
              <dd class="mt-2 font-display text-3xl text-crimson sm:text-4xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ===================== BIOS ===================== -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHeading eyebrow="Approved copy" title="Artist Bios" />

      <p class="reveal mt-5 max-w-2xl font-sans leading-relaxed text-ash">
        Use whichever length fits. These are the official bios — please do not paraphrase
        pronouns or the artist name, which is styled HEXXA in all caps.
      </p>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="space-y-6">
          <CopyBlock label="One-liner" text={bio.oneLiner} />
          <CopyBlock label="Short bio" text={bio.short} />
        </div>
        <CopyBlock label="Long bio" text={bio.long} />
      </div>
    </div>
  </section>

  <!-- ===================== PHOTOS ===================== -->
  <section class="border-y border-bone/10 bg-ink py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Imagery" title="Press Photos" />

        {
          pressAssets.photoPack && (
            <CTAButton href={pressAssets.photoPack} icon="download" class="reveal">
              Download all
            </CTAButton>
          )
        }
      </div>

      <div class="mt-12 grid grid-cols-2 gap-5 lg:grid-cols-4">
        {
          pressPhotos.map((photo, index) => (
            <figure class="reveal border border-bone/10">
              <BrandImage
                src={photo.src}
                alt={photo.alt}
                ratio={photo.ratio}
                tone={index % 2 === 0 ? "crimson" : "violet"}
                placeholderLabel={photo.alt}
              />
              {photo.credit && (
                <figcaption class="px-3 py-2 font-sans text-[0.62rem] uppercase tracking-[0.14em] text-ash">
                  Photo: {photo.credit}
                </figcaption>
              )}
            </figure>
          ))
        }
      </div>

      <p class="reveal mt-6 font-sans text-xs text-ash">
        Photo credit must be retained where supplied. Do not crop the artist out of frame or
        recolour images.
      </p>
    </div>
  </section>

  <!-- ===================== DOWNLOADS ===================== -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHeading eyebrow="Assets" title="Downloads" />

      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {
          downloads.map((item) => (
            <li class="reveal">
              {item.file ? (
                <a
                  href={item.file}
                  class="group flex items-center justify-between gap-4 border border-bone/10 bg-void/40 px-5 py-5 transition-colors hover:border-crimson"
                >
                  <div>
                    <h3 class="font-display text-lg tracking-wide text-bone">{item.label}</h3>
                    <p class="mt-1 font-sans text-xs text-ash">{item.note}</p>
                  </div>
                  <Icon
                    name="download"
                    size={20}
                    class="shrink-0 text-crimson transition-transform group-hover:translate-y-0.5"
                  />
                </a>
              ) : (
                <div class="flex items-center justify-between gap-4 border border-dashed border-bone/15 px-5 py-5">
                  <div>
                    <h3 class="font-display text-lg tracking-wide text-bone/50">
                      {item.label}
                    </h3>
                    <p class="mt-1 font-sans text-xs text-ash">{item.note}</p>
                  </div>
                  <span class="shrink-0 font-sans text-[0.6rem] font-bold uppercase tracking-[0.18em] text-ash">
                    Coming soon
                  </span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== QUOTES ===================== -->
  <section class="border-y border-bone/10 bg-ink py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHeading eyebrow="In her words" title="Quotes" />

      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-x-16">
        {
          bio.quotes.map((quote) => (
            <PressQuote text={quote.text} source={quote.source} context={quote.context} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== CONTACTS + PROFILES ===================== -->
  <section class="relative overflow-hidden py-16 lg:py-24">
    <Sigil
      size={480}
      spin
      class="pointer-events-none absolute -right-32 top-8 text-crimson/[0.06]"
    />

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <SectionHeading eyebrow="Get in touch" title="Contacts" />

          <ul class="mt-10 space-y-4">
            {
              contacts.map((contact) => (
                <li class="reveal border border-bone/10 bg-void/40 p-6">
                  <p class="font-sans text-[0.62rem] font-bold uppercase tracking-[0.22em] text-crimson">
                    {contact.role}
                    {contact.note && <span class="text-ash"> · {contact.note}</span>}
                  </p>
                  <p class="mt-3 font-display text-2xl tracking-wide text-bone">
                    {contact.name}
                  </p>
                  <p class="mt-1 font-sans text-sm text-ash">{contact.company}</p>
                  <a
                    href={mailto(contact, `${contact.role} enquiry — HEXXA`)}
                    class="link-wipe mt-3 inline-flex items-center gap-2 font-sans text-sm break-all text-crimson"
                  >
                    <Icon name="mail" size={15} />
                    {contact.email}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <SectionHeading eyebrow="Verified profiles" title="Official Links" />

          <ul class="mt-10 divide-y divide-bone/10 border-y border-bone/10">
            {
              socials.map((social) => (
                <li class="reveal">
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-between gap-4 py-4 transition-colors hover:text-crimson"
                  >
                    <span class="inline-flex items-center gap-3 font-sans text-sm text-bone group-hover:text-crimson">
                      <Icon name={social.icon} size={18} class="text-crimson" />
                      {social.label}
                    </span>
                    <Icon
                      name="arrow"
                      size={16}
                      class="shrink-0 text-ash transition-transform group-hover:translate-x-1 group-hover:text-crimson"
                    />
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="reveal mt-8 border border-bone/10 bg-void/40 p-6">
            <p class="font-sans text-[0.62rem] font-bold uppercase tracking-[0.22em] text-crimson">
              Billing
            </p>
            <p class="mt-3 font-display text-3xl tracking-wide text-bone">HEXXA</p>
            <p class="mt-2 font-sans text-sm leading-relaxed text-ash">
              Always all caps. Pronouns she/her in artist context. Never abbreviate or
              hyphenate.
            </p>
            <a
              href={links.linktree}
              target="_blank"
              rel="noopener noreferrer"
              class="link-wipe mt-4 inline-block font-sans text-sm text-crimson"
            >
              linktr.ee/hexxaofficial
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
