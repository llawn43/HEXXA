---
import Icon from "./Icon.astro";
import { socials } from "../data/socials";

interface Props {
  /** Show every profile, or just the four primaries. */
  all?: boolean;
  size?: number;
  class?: string;
}

const { all = false, size = 22, class: className = "" } = Astro.props;
const shown = all ? socials : socials.filter((social) => social.primary);
---

<ul class:list={["flex flex-wrap items-center gap-3", className]}>
  {
    shown.map((social) => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center border border-bone/15 text-bone/70 transition-all duration-200 hover:border-crimson hover:bg-crimson hover:text-void"
        >
          <span class="sr-only">{social.label}</span>
          <Icon name={social.icon} size={size} />
        </a>
      </li>
    ))
  }
</ul>
