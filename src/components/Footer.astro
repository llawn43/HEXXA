---
import Sigil from "./Sigil.astro";
import Icon from "./Icon.astro";
import { nav, navCta } from "../data/nav";
import { socials } from "../data/socials";
import { contacts, mailto } from "../data/contacts";
import { site } from "../data/site";
import { href } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="relative border-t border-bone/10 bg-ink">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bleed-gradient opacity-70"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
      <div>
        <div class="flex items-center gap-3">
          <Sigil size={40} class="text-crimson" spin />
          <span class="font-display text-3xl tracking-[0.14em] text-bone">HEXXA</span>
        </div>
        <p class="mt-4 max-w-xs font-sans text-sm leading-relaxed text-ash">
          {site.tagline}
        </p>
        <p class="mt-4 max-w-xs font-display text-lg leading-tight text-crimson">
          {site.callToArms}
        </p>
      </div>

      <div>
        <h2 class="font-sans text-[0.66rem] font-bold uppercase tracking-[0.24em] text-ash">
          Explore
        </h2>
        <ul class="mt-5 space-y-3">
          {
            [...nav, navCta].map((item) => (
              <li>
                <a
                  href={href(item.path)}
                  class="link-wipe font-sans text-sm text-bone/80 transition-colors hover:text-crimson"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-[0.66rem] font-bold uppercase tracking-[0.24em] text-ash">
          Follow
        </h2>
        <ul class="mt-5 space-y-3">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-wipe inline-flex items-center gap-2 font-sans text-sm text-bone/80 transition-colors hover:text-crimson"
                >
                  <Icon name={social.icon} size={16} />
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-[0.66rem] font-bold uppercase tracking-[0.24em] text-ash">
          Contact
        </h2>
        <ul class="mt-5 space-y-5">
          {
            contacts.map((contact) => (
              <li>
                <p class="font-sans text-[0.66rem] font-bold uppercase tracking-[0.2em] text-crimson">
                  {contact.role}
                </p>
                <p class="mt-1 font-sans text-sm text-bone">{contact.name}</p>
                <a
                  href={mailto(contact, `${contact.role} enquiry — HEXXA`)}
                  class="link-wipe font-sans text-sm break-all text-ash transition-colors hover:text-crimson"
                >
                  {contact.email}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col-reverse items-start justify-between gap-4 border-t border-bone/10 pt-6 sm:flex-row sm:items-center"
    >
      <p class="font-sans text-xs text-ash">
        &copy; {year} HEXXA. All rights reserved.
      </p>
      <p class="font-sans text-[0.66rem] uppercase tracking-[0.24em] text-ash">
        Made in Philadelphia
      </p>
    </div>
  </div>
</footer>
