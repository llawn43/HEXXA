---
interface Props {
  text: string;
  source: string;
  context?: string;
  size?: "md" | "lg";
  class?: string;
}

const { text, source, context, size = "md", class: className = "" } = Astro.props;
---

<figure class:list={["reveal relative pl-6", className]}>
  <span class="absolute left-0 top-1 h-[calc(100%-0.5rem)] w-px bleed-gradient" aria-hidden="true"
  ></span>

  <blockquote
    class:list={[
      "text-pretty font-display leading-tight tracking-wide text-bone",
      size === "lg" ? "text-2xl sm:text-3xl" : "text-lg sm:text-xl",
    ]}
  >
    &ldquo;{text}&rdquo;
  </blockquote>

  <figcaption class="mt-3 font-sans text-xs uppercase tracking-[0.18em] text-crimson">
    {source}
    {context && <span class="text-ash normal-case tracking-normal"> &mdash; {context}</span>}
  </figcaption>
</figure>
