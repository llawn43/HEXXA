---
import Sigil from "./Sigil.astro";

/** Shared masthead for inner pages, sitting below the fixed header. */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="relative overflow-hidden border-b border-bone/10 bg-ink pt-32 pb-14 lg:pt-40 lg:pb-20">
  <Sigil
    size={520}
    class="pointer-events-none absolute -right-32 -top-24 text-crimson/[0.055] lg:-right-16"
    spin
  />
  <div
    class="pointer-events-none absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-violet/10 blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bleed-gradient" aria-hidden="true"></span>
      <span class="font-sans text-[0.66rem] font-bold uppercase tracking-[0.26em] text-crimson">
        {eyebrow}
      </span>
    </div>

    <h1 class="mt-4 text-[length:var(--text-display)] text-bone">{title}</h1>

    {
      lede && (
        <p class="mt-5 max-w-2xl text-pretty font-sans text-base leading-relaxed text-ash sm:text-lg">
          {lede}
        </p>
      )
    }

    <slot />
  </div>
</section>
