---
import BrandImage from "./BrandImage.astro";
import Icon from "./Icon.astro";
import { releaseCredit, type Release } from "../data/releases";
import { links } from "../data/socials";

interface Props {
  release: Release;
  /** Alternate the placeholder tone so a grid never looks uniform. */
  tone?: "crimson" | "violet" | "split";
  /** Keeps the document outline correct when cards nest under a heading. */
  headingLevel?: "h3" | "h4";
}

const { release, tone = "split", headingLevel: Heading = "h3" } = Astro.props;

// Fall back to the artist profiles when a release has no verified smart link,
// so a card never leads to a dead page.
const primaryHref =
  release.links?.smartLink ??
  release.links?.spotify ??
  release.links?.beatport ??
  release.links?.soundcloud ??
  links.spotifyArtist;

const platformLinks = [
  { label: "Spotify", href: release.links?.spotify, icon: "spotify" },
  { label: "Beatport", href: release.links?.beatport, icon: "beatport" },
  { label: "SoundCloud", href: release.links?.soundcloud, icon: "soundcloud" },
].filter((link): link is { label: string; href: string; icon: string } => Boolean(link.href));

const credit = releaseCredit(release);
---

<article class="reveal group relative flex flex-col">
  <a
    href={primaryHref}
    target="_blank"
    rel="noopener noreferrer"
    class="relative block overflow-hidden border border-bone/10 transition-colors group-hover:border-crimson/60"
  >
    <BrandImage
      src={release.artwork}
      alt={`${release.title} by ${credit} — cover art`}
      ratio="1/1"
      tone={tone}
      placeholderLabel={`${release.title} — artwork`}
      class="transition-transform duration-500 group-hover:scale-[1.04]"
    />

    <!-- Play affordance, revealed on hover/focus of the card link. -->
    <span
      class="absolute inset-0 flex items-center justify-center bg-void/55 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
      aria-hidden="true"
    >
      <span
        class="flex h-14 w-14 items-center justify-center rounded-full bg-crimson text-void glow-crimson"
      >
        <Icon name="play" size={20} />
      </span>
    </span>

    {
      release.startHere && (
        <span class="absolute left-0 top-0 bleed-gradient px-3 py-1.5 font-sans text-[0.6rem] font-bold uppercase tracking-[0.18em] text-bone">
          Start here
        </span>
      )
    }

    <span class="sr-only">Listen to {release.title}</span>
  </a>

  <div class="mt-4 flex flex-1 flex-col">
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-sans text-[0.62rem] font-bold uppercase tracking-[0.2em] text-crimson">
        {release.type}
      </span>
      <span class="font-sans text-[0.62rem] uppercase tracking-[0.16em] text-ash">
        {release.year}
      </span>
    </div>

    <Heading class="mt-2 font-display text-xl leading-tight tracking-wide text-bone">
      {release.title}
    </Heading>

    <p class="mt-1 font-sans text-sm text-ash">{credit}</p>

    {
      release.label && (
        <p class="mt-1 font-sans text-xs text-ash">{release.label}</p>
      )
    }

    {
      release.appearsOn && (
        <p class="mt-1 font-sans text-xs italic text-ash">on {release.appearsOn}</p>
      )
    }

    {
      release.tracks && (
        <ol class="mt-3 space-y-1">
          {release.tracks.map((track, index) => (
            <li class="flex gap-2 font-sans text-xs text-ash">
              <span class="text-crimson">{String(index + 1).padStart(2, "0")}</span>
              {track}
            </li>
          ))}
        </ol>
      )
    }

    {
      platformLinks.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-3">
          {platformLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-sans text-[0.62rem] font-bold uppercase tracking-[0.16em] text-bone/70 transition-colors hover:text-crimson"
            >
              <Icon name={link.icon} size={14} />
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
